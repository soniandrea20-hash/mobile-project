# API base URL. Android emulator uses http://10.0.2.2:3000 by default.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Web: the tenant is the subdomain of this base domain (local1.localhost).
EXPO_PUBLIC_BASE_DOMAIN=localhost
# Fallback tenant when the host has no subdomain (Android, plain localhost).
EXPO_PUBLIC_TENANT_SLUG=local1
EXPO_PUBLIC_STORE_SLUG=palermo
