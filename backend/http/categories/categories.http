@baseUrl = http://localhost:3000
@tenant = local1
@email = owner@local1.test
@password = Local1-dev-2026

### Login (guarda el token)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

@token = {{login.response.body.$.access_token}}

### Obtener el local (guarda store_id)
# @name stores
GET {{baseUrl}}/stores
X-Tenant-Slug: {{tenant}}
Authorization: Bearer {{token}}

@storeId = {{stores.response.body.$[0].store_id}}

### Listar categorias
GET {{baseUrl}}/categories?store_id={{storeId}}
X-Tenant-Slug: {{tenant}}
Authorization: Bearer {{token}}

### Crear categoria (guarda category_id)
# @name newCategory
POST {{baseUrl}}/categories
X-Tenant-Slug: {{tenant}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "store_id": "{{storeId}}", "name": "Entradas", "sort_order": 4 }

@categoryId = {{newCategory.response.body.$.category_id}}

### Nombre repetido (409 CATEGORY_NAME_TAKEN)
POST {{baseUrl}}/categories
X-Tenant-Slug: {{tenant}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "store_id": "{{storeId}}", "name": "entradas" }

### Editar categoria
PATCH {{baseUrl}}/categories/{{categoryId}}
X-Tenant-Slug: {{tenant}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Para empezar", "sort_order": 5 }

### Borrar categoria (204)
DELETE {{baseUrl}}/categories/{{categoryId}}
X-Tenant-Slug: {{tenant}}
Authorization: Bearer {{token}}
