@baseUrl = http://localhost:3000
@tenant = local1
@email = owner@local1.test
@password = Local1-dev-2026

### Login (guarda el token)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

@token = {{login.response.body.$.access_token}}

### Obtener el local (guarda store_id)
# @name stores
GET {{baseUrl}}/stores
X-Tenant-Slug: {{tenant}}
Authorization: Bearer {{token}}

@storeId = {{stores.response.body.$[0].store_id}}

### Producto disponible para el pedido
# @name products
GET {{baseUrl}}/products?store_id={{storeId}}&is_available=true
X-Tenant-Slug: {{tenant}}
Authorization: Bearer {{token}}

@productId = {{products.response.body.$[0].product_id}}

### Crear pedido como cliente publico (guarda order_id)
# @name newOrder
POST {{baseUrl}}/public/stores/palermo/orders
X-Tenant-Slug: {{tenant}}
Content-Type: application/json

{ "items": [{ "product_id": "{{productId}}", "quantity": 2 }], "customer_name": "Ana", "note": "Sin hielo" }

@orderId = {{newOrder.response.body.$.order_id}}

### Listar ordenes (paginado, filtros opcionales)
GET {{baseUrl}}/orders?store_id={{storeId}}&status=generada&page=1&limit=20
X-Tenant-Slug: {{tenant}}
Authorization: Bearer {{token}}

### Detalle de la orden
GET {{baseUrl}}/orders/{{orderId}}
X-Tenant-Slug: {{tenant}}
Authorization: Bearer {{token}}

### Cambiar estado: generada a en_preparacion
PATCH {{baseUrl}}/orders/{{orderId}}/status
X-Tenant-Slug: {{tenant}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "status": "en_preparacion" }

### Salto de estado invalido (409 INVALID_STATUS_TRANSITION)
PATCH {{baseUrl}}/orders/{{orderId}}/status
X-Tenant-Slug: {{tenant}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "status": "entregada" }

### Estado desconocido (400)
PATCH {{baseUrl}}/orders/{{orderId}}/status
X-Tenant-Slug: {{tenant}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "status": "volando" }
