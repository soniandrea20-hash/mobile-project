# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu_password
DB_NAME=mobile_project

# JWT
JWT_SECRET=esto-es-un-secreto-para-jwt
JWT_EXPIRE_SECONDS=600
# TENANT
BASE_DOMAIN=localhost
WEB_ORIGIN_TEMPLATE=http://{slug}.localhost:8081
# MEDIA
# Azure Blob Storage for uploaded media. When the connection string is unset, files go to UPLOADS_DIR on local disk.
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=media
# Optional: public base URL /media redirects to (defaults to the container URL, e.g. a CDN or Azurite).
# MEDIA_PUBLIC_BASE_URL=
# Local disk directory for uploads (used when Blob is not configured).
# UPLOADS_DIR=./uploads
